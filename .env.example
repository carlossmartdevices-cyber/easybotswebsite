BOT_TOKEN=your_bot_token_here
BOT_USERNAME=pnptv_bot

# Admin Configuration
ADMIN_IDS=12345678,87654321

# Redis Configuration (for rate limiting)
REDIS_URL=redis://localhost:6379

# PostgreSQL Configuration (for user management, analytics, and admin features)
DB_HOST=localhost
DB_PORT=5432
DB_USER=pnptv
DB_PASSWORD=your_secure_password_here
DB_NAME=pnptv_prod
DB_NAME_TEST=pnptv_test
DB_SSL=false  # Set to true for cloud-hosted databases (Supabase, Neon, etc.)

# Firebase Configuration (DEPRECATED - Only needed for data migration)
# Once migration is complete, these can be removed
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
# FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# Environment
NODE_ENV=development
