{
  "name": "pnptv-telegram-bot",
  "version": "1.0.0",
  "description": "Production-ready Telegram bot for PNPtv with group/private chat routing",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "migrate:firestore": "node database/migrate-firestore-to-postgres.js",
    "migrate:firestore:dry-run": "node database/migrate-firestore-to-postgres.js --dry-run"
  },
  "keywords": [
    "telegram",
    "bot",
    "pnptv"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "firebase-admin": "^13.6.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "redis": "^4.6.11",
    "sequelize": "^6.35.2",
    "telegraf": "^4.15.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
